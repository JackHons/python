{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node --import ./tests/register-cloudflare-workers-loader.mjs --test tests/rendered-html.test.mjs",
    "test:phase1": "node --experimental-strip-types --test tests/auth.integration.test.mjs tests/rbac.integration.test.mjs tests/import.integration.test.mjs tests/education-api.integration.test.mjs",
    "test:phase2": "node --experimental-strip-types --test tests/materials.integration.test.mjs tests/material-library.integration.test.mjs tests/questions.integration.test.mjs tests/assignments.integration.test.mjs tests/submissions.integration.test.mjs",
    "test:phase3": "node --experimental-strip-types --test tests/runner-proxy.test.mjs tests/execution.integration.test.mjs tests/grading.integration.test.mjs tests/hidden-tests.security.test.mjs",
    "test:phase4": "node --experimental-strip-types --test tests/ai-provider.unit.test.mjs tests/ai-quota.concurrency.test.mjs tests/ai-review.integration.test.mjs tests/ai-privacy.security.test.mjs",
    "test:phase5": "node --experimental-strip-types --test tests/classroom.integration.test.mjs tests/notifications.integration.test.mjs tests/email.retry.test.mjs tests/classroom.rbac.security.test.mjs",
    "test:phase6": "node --experimental-strip-types --test tests/analytics.integration.test.mjs tests/export.excel.test.mjs tests/export.pdf.test.mjs tests/audit.integration.test.mjs tests/backup.restore.test.mjs",
    "backend": "node --experimental-strip-types server/http/cli.ts",
    "converter": "node --experimental-strip-types services/converter/worker.mjs",
    "email-worker": "node --experimental-strip-types services/notifications/worker.mjs",
    "test:phase7": "node --experimental-strip-types --test tests/backend.contract.test.mjs tests/backend.e2e.test.mjs",
    "test:all": "node --import ./tests/register-cloudflare-workers-loader.mjs --experimental-strip-types --test tests/*.test.mjs",
    "load:phase8": "node --experimental-strip-types scripts/phase8-host-load.mjs",
    "security:phase8": "sh scripts/phase8-security-scan.sh",
    "runner:phase8": "python3 scripts/phase8-runner-host-smoke.py",
    "test:phase8": "npm run security:phase8 && npm run load:phase8 && npm run runner:phase8",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-loading-skeleton": "3.5.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.60.1",
    "@cloudflare/workers-types": "5.20260925.2",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.12",
    "vite": "8.3.1",
    "wrangler": "4.140.0"
  },
  "type": "module"
}
