# Local template only. Replace every secret before production; these values
# are intentionally invalid placeholders and must not be used as credentials.
BACKEND_INTERNAL_TOKEN=replace-with-a-random-backend-token-at-least-24-chars
PUBLIC_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RUNNER_SERVICE_TOKEN=replace-with-a-random-runner-token-at-least-24-chars
# Local/internal mode is intentionally weak; public/high-risk deployments must
# provide a verified disposable strong executor and enable the requirement.
RUNNER_ISOLATION_MODE=local_process
RUNNER_REQUIRE_STRONG_ISOLATION=false
AI_MASTER_KEY=replace-with-a-32-byte-base64-or-64-char-hex-key
# Keep true for HTTPS production. For the documented local HTTP-only smoke test,
# explicitly set SESSION_COOKIE_SECURE=false in the shell running Compose.
SESSION_COOKIE_SECURE=true

# Production legacy runner route is disabled; only authenticated backend
# submission grading is allowed.
ALLOW_LEGACY_RUN=false
NEXT_PUBLIC_DEMO_MODE=false

# Backend service and local storage defaults.
BACKEND_PORT=8787
BACKEND_URL=http://127.0.0.1:8787
DATABASE_PATH=./var/db/learning.sqlite
STORAGE_ROOT=./var/storage
EXPORT_STORAGE_ROOT=./var/exports
BACKUP_ROOT=./var/backups
BACKUP_ENABLED=false
BACKUP_RETENTION_DAYS=30

# Optional email adapter. Local tests use the fake mailer.
EMAIL_ENABLED=false
EMAIL_FROM=python-learning@example.invalid
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_MS=10000
EMAIL_WORKER_INTERVAL_MS=10000
MAILPIT_WEB_PORT=8025
